{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bobata-isonline",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",

  // The prerendered site. `directory` must match the Vite build output.
  // Requests fall through to the Worker (worker/index.ts) only when no
  // matching asset exists, so /api/* reaches code and everything else is
  // served straight from the edge.
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Neither value is secret: the AUD tag is already inside every Access
  // JWT's own `aud` claim (see worker/access.ts), and the team domain is
  // just a URL. Safe to commit.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "misty-dream-75cd.cloudflareaccess.com",
    "ACCESS_AUD": "50ffacc4d5ad1a91e0f00c0756f7e76e824ffe6042a6b6fbd5ef2e8990663e74",
    // Not secret — it's the public read URL of a public bucket, already
    // reachable by anyone with an object key. Swap to a path on the real
    // domain once one is bought (task #21); nothing else needs to change.
    "R2_PUBLIC_URL": "https://pub-2496318461cb4c5398c7ac0c4b19bc88.r2.dev"
  },

  // Cloudflare's own SQLite, bound directly into the Worker — no
  // connection string, no separate credential to leak. `wrangler dev`
  // spins up a local copy automatically; migrations/ is applied to both
  // local and remote with `wrangler d1 migrations apply`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bobata-db",
      "database_id": "7193bfed-b884-4e80-bdbb-8c6aa30bead3",
      "migrations_dir": "./migrations"
    }
  ],

  // Uploaded images (posters, future diary photos). Public read access is
  // on at the bucket level via its r2.dev URL — writes still only happen
  // through the Access-gated /api/admin/upload route, never directly.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "bobata-media"
    }
  ]

  // Secrets are NOT set here — they would end up in git. Set them with
  // `wrangler secret put RESEND_API_KEY` or in the Worker's dashboard
  // settings: RESEND_API_KEY, CONTACT_TO, CONTACT_FROM, GITHUB_DISPATCH_TOKEN
  // (see worker/rebuild.ts — a fine-grained GitHub PAT scoped to this repo's
  // Actions: write permission only, used to trigger publish-rebuild.yml).
}
