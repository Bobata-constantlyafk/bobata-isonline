# Cloudflare Pages. Vite's /assets/* filenames are content-hashed, and the
# self-hosted fonts change only when deliberately replaced, so both are safe
# to cache immutably for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
